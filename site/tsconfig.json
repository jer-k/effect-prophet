{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "paths": {
      "effect-prophet": ["../src/index.ts"]
    },
    "plugins": [
      {
        "name": "@effect/language-service",
        // The tracing guide exports spans with Effect's OTLP layers, which have no stable equivalent.
        "allowedUnstableApis": ["effect/observability", "effect/http/FetchHttpClient#layer"]
      }
    ]
  },
  "include": ["snippets/**/*.ts", "scripts/**/*.ts", ".vitepress/**/*.ts", "benchmarks/**/*.ts"]
}
