{
  "name": "effect-prophet",
  "version": "0.1.0",
  "description": "Effect-based time-series forecasting with a Rust/WASM numerical backend",
  "keywords": [
    "effect",
    "forecasting",
    "prophet",
    "rust",
    "time-series",
    "wasm"
  ],
  "homepage": "https://jer-k.github.io/effect-prophet/",
  "bugs": {
    "url": "https://github.com/jer-k/effect-prophet/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jer-k/effect-prophet.git"
  },
  "files": [
    "dist",
    "wasm"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "clean": "node tools/clean-build.ts",
    "build": "npm run clean && npm run build:wasm:production && npm run build:typescript",
    "build:typescript": "rolldown -c",
    "build:wasm": "wasm-pack build rust/prophet-wasm --target nodejs --dev --out-dir ../../wasm && node tools/prepare-wasm-package.ts",
    "build:wasm:production": "wasm-pack build rust/prophet-wasm --target nodejs --release --out-dir ../../wasm && node tools/prepare-wasm-package.ts",
    "prepack": "npm run build",
    "pretest": "npm run build:wasm:production",
    "test": "vitest run --dir test",
    "test:package": "npm run build && node tools/test-package.ts",
    "notices:check": "node tools/check-third-party-notices.ts",
    "docs:dev": "vitepress dev site",
    "docs:build": "vitepress build site",
    "docs:preview": "vitepress preview site",
    "docs:typecheck": "tsc --noEmit -p site/tsconfig.json",
    "docs:examples": "npm run build && node site/scripts/run-snippets.ts",
    "test:integration:prophet": "npm run build:wasm:production && vitest run --dir integration/tests/prophet-1.4.0",
    "fixtures:generate": "docker compose --profile fixtures-generate run --rm --build prophet-fixtures-generate",
    "fixtures:check": "docker compose --profile fixtures-check run --rm --build prophet-fixtures-check && docker compose --profile fixtures-check run --rm --build --no-deps effect-prophet-fixtures",
    "benchmark": "node benchmark/tools/run.ts",
    "benchmark:setup": "node benchmark/tools/generate-data.ts",
    "benchmark:builder": "docker buildx create --name effect-prophet-benchmark --driver docker-container --driver-opt default-load=true --buildkitd-config benchmark/tools/runtime/docker/buildkitd.toml --bootstrap",
    "benchmark:contained": "BUILDX_BUILDER=effect-prophet-benchmark node benchmark/tools/run.ts",
    "benchmark:test": "vitest run --config benchmark/vitest.config.ts",
    "benchmark:typecheck": "tsc --noEmit -p benchmark/tsconfig.json",
    "benchmark:baseline": "node benchmark/tools/retain.ts",
    "benchmark:retain": "node benchmark/tools/retain.ts",
    "benchmark:catalog": "node benchmark/tools/catalog-cli.ts",
    "benchmark:results": "node benchmark/tools/results-cli.ts",
    "benchmark:compare": "node benchmark/tools/compare-cli.ts",
    "test:rust": "cargo test --manifest-path rust/prophet-wasm/Cargo.toml",
    "test:wasm": "npm run build:wasm:production && node --test rust/prophet-wasm/node-tests/*.test.ts",
    "test:wasm:optimizer": "wasm-pack test --node --release rust/prophet-wasm --locked",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "lint:rust": "cargo clippy --manifest-path rust/prophet-wasm/Cargo.toml --all-targets -- -D warnings",
    "format": "oxfmt --write .",
    "format:rust": "cargo fmt --manifest-path rust/prophet-wasm/Cargo.toml",
    "format:check": "oxfmt --check .",
    "format:rust:check": "cargo fmt --manifest-path rust/prophet-wasm/Cargo.toml --check",
    "check": "npm run format:check && npm run format:rust:check && npm run lint && npm run lint:rust && npm run notices:check && npm run typecheck && npm run benchmark:typecheck && npm test && npm run benchmark:test && npm run test:integration:prophet && npm run test:rust && npm run test:wasm && npm run test:wasm:optimizer && npm run test:package"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.82.0",
    "@types/node": "^26.4.0",
    "effect": "4.0.0",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.87.0",
    "rolldown": "^1.2.8",
    "rolldown-plugin-dts": "^0.28.0",
    "typescript": "^7.0.2",
    "vitepress": "2.0.0-alpha.20",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "effect": "^4.0.0"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "npm@11.12.1"
}
